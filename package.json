{
  "name": "@imcat-ckim/catui",
  "version": "2.0.0",
  "license": "MIT",
  "author": "imcatDevs <imcat@imcat.dev>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ckim19800220-cpu/Catui.git"
  },
  "homepage": "https://github.com/ckim19800220-cpu/Catui#readme",
  "bugs": {
    "url": "https://github.com/ckim19800220-cpu/Catui/issues"
  },
  "description": "한국어 관리 화면·공개 홈을 위한 CSS 키트와 의존성 없는 UI 프레임워크 catui.js",
  "keywords": [
    "ui",
    "css",
    "framework",
    "korean",
    "admin",
    "components",
    "accessibility",
    "wcag"
  ],
  "type": "module",
  "main": "./dist/catui.esm.js",
  "module": "./dist/catui.esm.js",
  "types": "./dist/catui.d.ts",
  "unpkg": "./dist/catui.min.js",
  "jsdelivr": "./dist/catui.min.js",
  "style": "./dist/catui.min.css",
  "exports": {
    ".": {
      "types": "./dist/catui.d.ts",
      "import": "./dist/catui.esm.js",
      "default": "./dist/catui.esm.js"
    },
    "./min": {
      "types": "./dist/catui.d.ts",
      "import": "./dist/catui.esm.min.js",
      "default": "./dist/catui.esm.min.js"
    },
    "./admin": {
      "types": "./dist/catadmin.d.ts",
      "import": "./dist/catadmin.esm.js",
      "default": "./dist/catadmin.esm.js"
    },
    "./admin.css": "./dist/admin.min.css",
    "./community": {
      "types": "./dist/catcommunity.d.ts",
      "import": "./dist/catcommunity.esm.js",
      "default": "./dist/catcommunity.esm.js"
    },
    "./community.css": "./dist/community.min.css",
    "./shop": {
      "types": "./dist/catshop.d.ts",
      "import": "./dist/catshop.esm.js",
      "default": "./dist/catshop.esm.js"
    },
    "./shop.css": "./dist/shop.min.css",
    "./docs": {
      "types": "./dist/catdocs.d.ts",
      "import": "./dist/catdocs.esm.js",
      "default": "./dist/catdocs.esm.js"
    },
    "./docs.css": "./dist/docs.min.css",
    "./booking": {
      "types": "./dist/catbooking.d.ts",
      "import": "./dist/catbooking.esm.js",
      "default": "./dist/catbooking.esm.js"
    },
    "./booking.css": "./dist/booking.min.css",
    "./css": "./dist/catui.min.css",
    "./catui.css": "./dist/catui.css",
    "./catui.min.css": "./dist/catui.min.css",
    "./icons.svg": "./dist/icons.svg",
    "./dist/*": "./dist/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "SECURITY.md"
  ],
  "sideEffects": [
    "*.css",
    "./dist/catui.js",
    "./dist/catui.min.js",
    "./dist/catui.esm.js",
    "./dist/catui.esm.min.js",
    "./dist/catadmin.js",
    "./dist/catadmin.min.js",
    "./dist/catadmin.esm.js",
    "./dist/catadmin.esm.min.js",
    "./dist/catcommunity.js",
    "./dist/catcommunity.min.js",
    "./dist/catcommunity.esm.js",
    "./dist/catcommunity.esm.min.js",
    "./dist/catshop.js",
    "./dist/catshop.min.js",
    "./dist/catshop.esm.js",
    "./dist/catshop.esm.min.js",
    "./dist/catdocs.js",
    "./dist/catdocs.min.js",
    "./dist/catdocs.esm.js",
    "./dist/catdocs.esm.min.js",
    "./dist/catbooking.js",
    "./dist/catbooking.min.js",
    "./dist/catbooking.esm.js",
    "./dist/catbooking.esm.min.js"
  ],
  "browserslist": [
    "chrome >= 111",
    "edge >= 111",
    "safari >= 16.4",
    "firefox >= 121"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:css": "node scripts/build.mjs --only=css",
    "build:js": "node scripts/build.mjs --only=js",
    "build:docs": "node scripts/build.mjs --only=docs",
    "dev": "node scripts/serve.mjs 8766",
    "test": "node tests/run.mjs",
    "check": "npm run build && npm test"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "lightningcss": "^1.30.2"
  }
}
